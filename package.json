    "build": "node tools/web/vite.mjs build",
    "build:candidate": "node tools/web/vite.mjs candidate",
    "preview": "node tools/web/vite.mjs preview",
    "typecheck": "tsc --project tsconfig.json",
    "resources:index": "node tools/index-evb.ts",
    "resources:scenes": "node tools/index-scenarios.ts",
    "resources:inspect-scripts": "node tools/prepare-script-inspection.ts",
    "resources:prepare-scenes": "node tools/prepare-scenarios.ts",
    "resources:base-views": "node tools/prepare-base-script-views.ts",
    "resources:bytecode": "node tools/prepare-tjs-bytecode.ts",
    "resources:raw-index": "node tools/index-xp3-exports.ts",
    "resources:image-inputs": "node tools/prepare-image-inputs.ts",
