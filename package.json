    "resources:attach-motion": "node tools/attach-motion-graphics.ts",
    "resources:execution-data": "node tools/prepare-execution-metadata.ts",
    "resources:execution-summary": "node tools/summarize-execution-metadata.ts",
    "resources:scene-control": "node tools/compile-scenario-control.ts",
    "resources:command-schema": "node tools/summarize-command-schema.ts",
    "resources:motion-programs": "node tools/compile-motion-programs.ts",
    "resources:audio": "node tools/prepare-audio.ts",
    "resources:audio-events": "node tools/compile-audio-events.ts",
    "resources:audio-index": "node tools/index-audio-sources.ts",
    "resources:world-plans": "node tools/compile-world-plans.ts",
    "resources:world-states": "node tools/prepare-world-states.ts",
    "resources:messages": "node tools/prepare-message-data.ts",
    "resources:data-definitions": "node tools/compile-tjs-data.ts",
