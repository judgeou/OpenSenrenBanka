    "resources:foreground-packs": "node tools/prepare-foreground-packs.ts",
    "resources:stand-templates": "node tools/compile-stand-templates.ts",
    "resources:image-requests": "node tools/prepare-image-requests.ts",
    "resources:scene-stand-bindings": "node tools/prepare-scene-stand-bindings.ts",
    "resources:xp3-names": "node tools/prepare-xp3-names.ts",
    "resources:foreground-identities": "node tools/prepare-foreground-raster-index.ts",
